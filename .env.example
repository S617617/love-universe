# GitHub Pages is a static host: do not configure or expose any API keys.
# Only NEXT_PUBLIC_BASE_PATH=/love-universe is set from next.config.ts (non-secret).
# The optional backend retained under src/server is NOT deployed on GitHub Pages.
# If you separately restore/deploy that backend, keep its keys in server-only env vars:
ENABLE_LIVE_AI=false
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
STORY_PASSWORD=
